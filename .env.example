# DF Forex Pro v2.8 - Netlify / Node / Deriv API
# Nunca coloque chaves reais no GitHub. Configure estes valores somente no Netlify > Environment variables.

# Site
PUBLIC_SITE_URL=https://df-forex.netlify.app

# Supabase backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Deriv API
# Recomendado para resolver invalid_client rapidamente: conecte pelo painel usando Token API Deriv.
# O token fica somente na sessão do navegador e é enviado ao backend como Bearer token.
# OAuth continua disponível, mas exige App ID válido e Redirect URL correto.
DERIV_AUTH_MODE=legacy_oauth
DERIV_APP_ID=
DERIV_LEGACY_APP_ID=

# Tokens manuais opcionais. O login OAuth pelo painel geralmente substitui isso.
DERIV_API_TOKEN_DEMO=
DERIV_API_TOKEN_LIVE=
DERIV_TRADE_MODE=data_only

# Execução
# Seguro inicial:
BOT_MODE=dry_run
ACCOUNT_TYPE=demo
ENABLE_ORDER_EXECUTION=false
DERIV_ENABLE_ORDER_EXECUTION=false
ALLOW_LIVE_TRADING=false

# Para Demo operacional pela API depois de validar:
# BOT_MODE=live
# ACCOUNT_TYPE=demo
# ENABLE_ORDER_EXECUTION=true
# DERIV_ENABLE_ORDER_EXECUTION=true
# ALLOW_LIVE_TRADING=false

# Para Real somente depois de validar Demo:
# BOT_MODE=live
# ACCOUNT_TYPE=real
# ENABLE_ORDER_EXECUTION=true
# DERIV_ENABLE_ORDER_EXECUTION=true
# ALLOW_LIVE_TRADING=true

DERIV_DEFAULT_STAKE=1
DERIV_CONTRACT_DURATION=5
DERIV_CONTRACT_DURATION_UNIT=m
MAX_TRADES_PER_RUN=1

FOREX_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
DEFAULT_TIMEFRAME_MINUTES=60
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_MONTHLY_DRAWDOWN_PCT=10
MIN_SIGNAL_SCORE=80

# OAuth2 PKCE moderno: use somente se você tiver client OAuth2 válido.
# DERIV_AUTH_MODE=oauth2_pkce
# DERIV_OAUTH_CLIENT_ID=
# DERIV_OAUTH_REDIRECT_URI=https://df-forex.netlify.app/deriv-callback.html
# DERIV_OAUTH_SCOPE=trade account_manage

# App ID usado no WebSocket da Deriv. Para PAT/token, 1089 costuma funcionar para teste; use seu App ID em produção.
DERIV_APP_ID=1089
DERIV_LEGACY_APP_ID=1089
