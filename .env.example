# DF Forex Pro v2.3 - exemplo seguro
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PUBLIC_SITE_URL=https://df-forex.netlify.app
BROKER_CONNECTOR=deriv_api
DERIV_AUTH_MODE=legacy_oauth_or_pat
DERIV_APP_ID=1089
DERIV_LEGACY_APP_ID=1089
DERIV_API_TOKEN_DEMO=
DERIV_API_TOKEN_LIVE=
DERIV_TRADE_MODE=data_only
# Para DEMO real pela API: coloque BOT_MODE=live, ENABLE_ORDER_EXECUTION=true e DERIV_ENABLE_ORDER_EXECUTION=true.
# Para REAL: além disso, coloque ACCOUNT_TYPE=real e ALLOW_LIVE_TRADING=true.
DERIV_ENABLE_ORDER_EXECUTION=false
DERIV_DEFAULT_STAKE=1
DERIV_CONTRACT_DURATION=5
DERIV_CONTRACT_DURATION_UNIT=m
MAX_TRADES_PER_RUN=1

BOT_MODE=dry_run
ACCOUNT_TYPE=demo
ENABLE_ORDER_EXECUTION=false
ALLOW_LIVE_TRADING=false

FOREX_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
DEFAULT_TIMEFRAME_MINUTES=60
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_MONTHLY_DRAWDOWN_PCT=10
MIN_SIGNAL_SCORE=80

# Retorno automático Deriv - recomendado
PUBLIC_SITE_URL=https://df-forex.netlify.app
DERIV_AUTH_MODE=oauth2_pkce
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_REDIRECT_URI=https://df-forex.netlify.app/deriv-callback.html
DERIV_OAUTH_SCOPE=trade account_manage
DERIV_LEGACY_APP_ID=
