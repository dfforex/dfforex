# DF Forex Pro v2 - Netlify/Node sem Python local
# Nunca coloque estas variáveis dentro do frontend.
# Configure no Netlify em: Site configuration > Environment variables.

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_APENAS_NO_NETLIFY_BACKEND
SUPABASE_ANON_KEY=OPCIONAL_NAO_USADO_NO_BROWSER_NESTA_VERSAO

# Segurança operacional
BOT_MODE=dry_run
ACCOUNT_TYPE=demo
ENABLE_ORDER_EXECUTION=false
ALLOW_LIVE_TRADING=false
MAX_RISK_PER_TRADE_PCT=0.50
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_MONTHLY_DRAWDOWN_PCT=10
MIN_SIGNAL_SCORE=80

# Broker
BROKER_CONNECTOR=deriv_api
DERIV_APP_ID=1089
DERIV_API_TOKEN_DEMO=COLOQUE_TOKEN_DEMO_DERIV_AQUI
DERIV_API_TOKEN_LIVE=
DERIV_TRADE_MODE=data_only
DERIV_ENABLE_ORDER_EXECUTION=false

# Símbolos iniciais Deriv/Forex
FOREX_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD
DEFAULT_TIMEFRAME_MINUTES=60
